{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="login-shell" aria-label="Réinitialisation du mot de passe">
            <aside class="login-visual" aria-label="Gestion du courrier">
                <div class="login-brand">
                    <span class="login-brand__mark" aria-hidden="true">
                        <img src="{{ asset('images/logo-gestion-courrier.png') }}" alt="">
                    </span>
                    <span>
                        <strong>Gestion du courrier</strong>
                        <small>Plateforme interne</small>
                    </span>
                </div>

                <ul class="login-visual__features" aria-label="Fonctionnalités principales">
                    <li>Registre consultable et exportable</li>
                    <li>Suivi des statuts, imputations et réponses</li>
                    <li>Historique des actions et traçabilité</li>
                </ul>
            </aside>

            <div class="login-panel">
                <div class="login-card__head">
                    <h2>Mot de passe oublié</h2>
                    <p>Entrez votre adresse email pour recevoir un lien de réinitialisation.</p>
                </div>

                {{ form_start(form, { attr: { class: 'login-form' } }) }}
                    {{ form_errors(form) }}

                    <div class="login-field">
                        {{ form_label(form.email) }}
                        <div class="login-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2"/>
                                <path d="m3 7 9 6 9-6"/>
                            </svg>
                            {{ form_widget(form.email, { attr: { autocomplete: 'email', placeholder: 'Votre email' } }) }}
                        </div>
                        {{ form_errors(form.email) }}
                    </div>

                    <button class="login-submit" type="submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 4h16v16H4z"/>
                            <path d="m4 7 8 6 8-6"/>
                            <path d="M12 13v5"/>
                            <path d="m9 16 3 3 3-3"/>
                        </svg>
                        <span>Envoyer le lien</span>
                    </button>

                    {{ form_rest(form) }}
                {{ form_end(form) }}

                <div class="login-help-note">
                    Si l'adresse est reconnue, un email de récupération sera envoyé. Vous pourrez revenir sur la page de connexion ensuite.
                </div>

                <a class="login-return" href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </section>
{% endblock %}
