{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="login-shell">
            <div class="login-card" style="max-width: 460px; margin: auto;">
                <div class="login-card__head">
                    <h2>Mot de passe oublié</h2>
                    <p>Entrez votre adresse email pour recevoir un lien de réinitialisation.</p>
                </div>

                {{ form_start(form, { attr: { class: 'login-form' } }) }}
                    {{ form_errors(form) }}
                    <div class="login-field">
                        {{ form_label(form.email) }}
                        <div class="login-input">
                            {{ form_widget(form.email, { attr: { autocomplete: 'email' } }) }}
                        </div>
                        {{ form_errors(form.email) }}
                    </div>

                    <button class="login-submit" type="submit">Envoyer le lien</button>
                    {{ form_rest(form) }}
                {{ form_end(form) }}

                <div class="login-note">
                    Si l'adresse est reconnue, un email de récupération sera envoyé. Vous pourrez revenir sur la page de connexion ensuite.
                </div>
                <p style="margin-top: 18px; text-align: center;">
                    <a href="{{ path('app_login') }}">Retour à la page de connexion</a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}
