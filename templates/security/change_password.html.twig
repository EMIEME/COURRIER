{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="topbar page-band">
        <div>
            <h1>Mon profil</h1>
            <p>Vos informations personnelles et la sécurité de votre compte.</p>
        </div>
    </div>

    <div class="profile-layout">
    <section class="form-panel profile-information" aria-labelledby="profile-information-title">
        <div class="profile-identity">
            <span class="profile-avatar" aria-hidden="true">{{ (profile.fullName ?: profile.email)|slice(0, 1)|upper }}</span>
            <div><h2>{{ profile.fullName ?: 'Mon compte' }}</h2><p>{{ profile.service ?: 'Service non renseigné' }}</p></div>
        </div>
        <div class="form-section__header">
            <h3 id="profile-information-title">Informations du compte</h3>
        </div>
        <dl class="profile-details">
            <div><dt>Nom</dt><dd>{{ profile.fullName ?: 'Non renseigné' }}</dd></div>
            <div><dt>Email</dt><dd>{{ profile.email }}</dd></div>
            <div><dt>Service</dt><dd>{{ profile.service ?: 'Non renseigné' }}</dd></div>
        </dl>
        <div class="profile-activity">
            <span>Courriers enregistrés par vous</span>
            <strong>{{ registeredCourriersCount|number_format(0, ',', ' ') }}</strong>
            <p>Total depuis le début, toutes natures et tous statuts confondus.</p>
        </div>
    </section>

    <section class="form-panel profile-password" aria-labelledby="profile-password-title">
        <div class="form-section__header">
            <h2 id="profile-password-title">Changer mon mot de passe</h2>
            <p>Confirmez votre mot de passe actuel, puis choisissez votre nouveau mot de passe.</p>
        </div>
        {{ form_start(form, {attr: {class: 'professional-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.plainPassword.first) }}
            {{ form_row(form.plainPassword.second) }}
            <div class="actions">
                <button class="button" type="submit">Modifier mon mot de passe</button>
            </div>
        {{ form_end(form) }}
    </section>
    </div>
{% endblock %}
