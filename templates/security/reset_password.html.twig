{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="login-shell">
            <div class="login-card" style="max-width: 460px; margin: auto;">
                <div class="login-card__head">
                    <h2>Réinitialiser le mot de passe</h2>
                    <p>Choisissez un nouveau mot de passe pour votre compte.</p>
                </div>

                {{ form_start(form, { attr: { class: 'login-form' } }) }}
                    {{ form_errors(form) }}
                    <div class="login-field">
                        {{ form_label(form.plainPassword) }}
                        <div class="login-input">
                            {{ form_widget(form.plainPassword, { attr: { autocomplete: 'new-password' } }) }}
                        </div>
                        {{ form_errors(form.plainPassword) }}
                    </div>

                    <button class="login-submit" type="submit">Modifier le mot de passe</button>
                    {{ form_rest(form) }}
                {{ form_end(form) }}

                <div class="login-note">
                    Après modification, vous pourrez vous connecter avec votre nouveau mot de passe.
                </div>
                <p style="margin-top: 18px; text-align: center;">
                    <a href="{{ path('app_login') }}">Retour à la page de connexion</a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}
