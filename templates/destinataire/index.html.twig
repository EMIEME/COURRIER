{% extends 'base.html.twig' %}

{% block title %}Destinataires{% endblock %}

{% block body %}
    <div class="topbar page-band">
        <div>
            <h1>Destinataires</h1>
            <p>Référentiel utilisé par le champ destinataire des courriers.</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('app_destinataire_new') }}">Ajouter un destinataire</a>
        </div>
    </div>

    <form class="form-panel filter-panel" method="get" action="{{ path('app_destinataire_index') }}">
        <div class="filter-primary">
            <div>
                <label for="q">Vérifier un nom</label>
                <input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Saisir un nom ou une partie du nom">
            </div>
            <div class="filter-actions">
                <button type="submit">Rechercher</button>
                <a class="button secondary" href="{{ path('app_destinataire_index') }}">Réinitialiser</a>
            </div>
        </div>
        {% if filters.q|default('') %}
            <div class="filter-chips" aria-label="Filtres actifs">
                <span class="filter-chip">
                    Recherche: {{ filters.q }}
                    <a class="filter-chip__remove" href="{{ path('app_destinataire_index') }}" aria-label="Retirer la recherche">×</a>
                </span>
            </div>
        {% endif %}
    </form>

    <div class="table-wrap is-colorful" data-loading-skeleton>
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Service</th>
                    <th>Email</th>
                    <th>Courriers</th>
                    <th class="table-actions-heading">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for destinataire in destinataires %}
                <tr>
                    <td class="table-cell--long" data-label="Nom"><strong class="cell-truncate">{{ destinataire.name }}</strong></td>
                    <td class="table-cell--long" data-label="Service"><span class="cell-truncate">{{ destinataire.service ?: '-' }}</span></td>
                    <td class="table-cell--long" data-label="Email"><span class="cell-truncate">{{ destinataire.email ?: '-' }}</span></td>
                    <td data-label="Courriers">
                        <a class="button compact secondary" href="{{ path('app_courrier_index', {destinataire: destinataire.id}) }}" title="Afficher les courriers liés à {{ destinataire.name }}">
                            {{ courrierCounts[destinataire.id]|default(0) }}
                        </a>
                    </td>
                    <td class="table-actions-cell" data-label="Actions">
                        <div class="row-actions">
                            <a class="button compact secondary" href="{{ path('app_destinataire_edit', {id: destinataire.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_destinataire_delete', {id: destinataire.id}) }}" onsubmit="return confirm('Supprimer ce destinataire ? Les courriers existants seront conservés.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-destinataire' ~ destinataire.id) }}">
                                <button class="danger compact" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="5">
                        <div class="empty-state empty-state--table">
                            <span class="empty-state__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                            </span>
                            <h2>Aucun destinataire trouvé</h2>
                            <p>
                                {% if filters.q|default('') %}
                                    Aucun destinataire ne correspond à ce nom.
                                {% else %}
                                    Ajoutez vos contacts pour les sélectionner plus vite dans les courriers entrants et sortants.
                                {% endif %}
                            </p>
                            <div class="actions">
                                {% if filters.q|default('') %}
                                    <a class="button secondary" href="{{ path('app_destinataire_index') }}">Réinitialiser les filtres</a>
                                {% endif %}
                                <a class="button" href="{{ path('app_destinataire_new') }}">Ajouter un destinataire</a>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pagination">
            <span>
                {{ pagination.total }} destinataire{{ pagination.total > 1 ? 's' : '' }}
                - page {{ pagination.page }} / {{ pagination.totalPages }}
            </span>
            <div class="actions">
                {% if pagination.page > 1 %}
                    <a class="button secondary" href="{{ path('app_destinataire_index', {q: filters.q|default(''), page: pagination.page - 1}) }}">Précédent</a>
                {% endif %}
                {% if pagination.page < pagination.totalPages %}
                    <a class="button secondary" href="{{ path('app_destinataire_index', {q: filters.q|default(''), page: pagination.page + 1}) }}">Suivant</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
