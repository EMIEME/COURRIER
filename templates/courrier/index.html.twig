{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle|default('Trouver un courrier') }}{% endblock %}

{% block body %}
    {% set pageTitle = pageTitle|default('Trouver un courrier') %}
    {% set listRoute = listRoute|default('app_courrier_index') %}
    {% set exportFilters = exportFilters|default(filters) %}
    {% set emptyMessage = emptyMessage|default('Aucun courrier ne correspond aux critères actuels.') %}
    {% set showAssignedFilter = showAssignedFilter is defined ? showAssignedFilter : true %}
    {% set showPendingDeletionActions = showPendingDeletionActions is defined ? showPendingDeletionActions : true %}
    {% set isMineView = isMineView is defined ? isMineView : false %}
    {% set isPendingDeletionView = isPendingDeletionView is defined ? isPendingDeletionView : false %}
    {% set selectedAssignedUsers = selectedAssignedUsers|default([]) %}
    {% set selectedStatuses = filters.status is defined and filters.status is iterable ? filters.status : (filters.status|default('') ? [filters.status] : []) %}
    {% set selectedDirections = filters.direction is defined and filters.direction is iterable ? filters.direction : (filters.direction|default('') ? [filters.direction] : []) %}
    {% set selectedAssignedToIds = filters.assignedTo is defined and filters.assignedTo is iterable ? filters.assignedTo : (filters.assignedTo|default('') ? [filters.assignedTo] : []) %}
    {% set selectedDueFilter = filters.dueFilter|default('') %}

    <div class="topbar page-band">
        <div>
            <h1>{{ pageTitle }}</h1>
        </div>
        <div class="actions">
            <a class="button secondary export-button" href="{{ path('app_courrier_export', exportFilters|merge({format: 'excel'})) }}" title="Exporter la liste filtrée vers Excel">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6"/>
                    <path d="M8 13h8"/>
                    <path d="M8 17h8"/>
                </svg>
                Excel
            </a>
            <a class="button secondary export-button" href="{{ path('app_courrier_export', exportFilters|merge({format: 'pdf'})) }}" title="Exporter la liste filtrée en PDF">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6"/>
                    <path d="M9 15h6"/>
                    <path d="M9 18h4"/>
                </svg>
                PDF
            </a>
            {% if isMineView %}
                <a class="button secondary" href="{{ path('app_courrier_index') }}">Tous les courriers</a>
            {% endif %}
            {% if is_granted('ROLE_COURRIER_EDIT') %}
                <a class="button" href="{{ path('app_courrier_new') }}">Créer un courrier</a>
            {% endif %}
            {% if showPendingDeletionActions and is_granted('ROLE_ADMIN') %}
                {% if isPendingDeletionView %}
                    <a class="button secondary" href="{{ path('app_courrier_index') }}">Courriers actifs</a>
                {% else %}
                    <a class="button secondary" href="{{ path('app_courrier_index', {pendingDeletion: 1}) }}">Suppressions en attente ({{ pendingDeletionCount }})</a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% set activeFilterParams = {
        q: filters.q|default(''),
        sender: filters.sender|default(''),
        status: selectedStatuses,
        direction: selectedDirections,
        dateFrom: filters.dateFrom|default(''),
        dateTo: filters.dateTo|default(''),
        dueFilter: selectedDueFilter,
        assignedTo: showAssignedFilter ? selectedAssignedToIds : [],
        destinataire: filters.destinataire|default(''),
        pendingDeletion: filters.pendingDeletion|default('')
    } %}
    {% set hasAdvancedFilters = filters.sender|default('') or selectedStatuses|length > 0 or selectedDirections|length > 0 or filters.dateFrom|default('') or filters.dateTo|default('') or selectedDueFilter or (showAssignedFilter and selectedAssignedToIds|length > 0) %}
    {% set hasActiveFilters = filters.q|default('') or hasAdvancedFilters or filters.destinataire|default('') or filters.pendingDeletion|default('') %}

    <form class="form-panel filter-panel" method="get" action="{{ path(listRoute) }}">
        {% if filters.destinataire|default('') %}
            <input type="hidden" name="destinataire" value="{{ filters.destinataire }}">
        {% endif %}
        {% if filters.pendingDeletion|default('') %}
            <input type="hidden" name="pendingDeletion" value="{{ filters.pendingDeletion }}">
        {% endif %}

        <div class="filter-primary">
            <div>
                <label for="q">Mots-clés</label>
                <input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Référence, objet, contenu...">
            </div>
            <div class="filter-actions">
                <button type="submit">Rechercher</button>
                <a class="button secondary" href="{{ path(listRoute) }}">Réinitialiser</a>
            </div>
        </div>

        <details class="filter-advanced" {{ hasAdvancedFilters ? 'open' : '' }}>
            <summary>Filtres avancés</summary>
            <div class="filter-advanced__grid">
                <div>
                    <label for="sender">Interlocuteur</label>
                    <input id="sender" name="sender" value="{{ filters.sender|default('') }}">
                </div>
                <div>
                    <label for="status">Statut</label>
                    <select id="status" name="status[]" class="sr-only-select" data-autocomplete-select="true" data-autocomplete-show-all="true" data-placeholder="Tous les statuts" multiple>
                        {% for label, value in statuses %}
                            <option value="{{ value }}" {{ value in selectedStatuses ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="direction">Nature</label>
                    <select id="direction" name="direction[]" class="sr-only-select" data-autocomplete-select="true" data-autocomplete-show-all="true" data-placeholder="Toutes les natures" multiple>
                        {% for label, value in directions %}
                            <option value="{{ value }}" {{ value in selectedDirections ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="dateFrom">Du</label>
                    <input type="date" id="dateFrom" name="dateFrom" value="{{ filters.dateFrom|default('') }}">
                </div>
                <div>
                    <label for="dateTo">Au</label>
                    <input type="date" id="dateTo" name="dateTo" value="{{ filters.dateTo|default('') }}">
                </div>
                <div>
                    <label for="dueFilter">Échéance</label>
                    <select id="dueFilter" name="dueFilter">
                        <option value="">Toutes les échéances</option>
                        {% for label, value in dueFilters %}
                            <option value="{{ value }}" {{ selectedDueFilter == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% if showAssignedFilter %}
                    <div>
                        <label for="assignedTo">Imputer à</label>
                        <select id="assignedTo" name="assignedTo[]" class="sr-only-select" data-autocomplete-select="true" data-autocomplete-show-all="true" data-placeholder="Toutes les imputations" multiple>
                            {% for user in users %}
                                <option value="{{ user.id }}" {{ user.id in selectedAssignedToIds ? 'selected' : '' }}>{{ user.fullName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
        </details>

        {% if hasActiveFilters %}
            <div class="filter-chips" aria-label="Filtres actifs">
                {% if filters.q|default('') %}
                    <span class="filter-chip">
                        Recherche: {{ filters.q }}
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({q: ''})) }}" aria-label="Retirer la recherche">×</a>
                    </span>
                {% endif %}
                {% if filters.sender|default('') %}
                    <span class="filter-chip">
                        Interlocuteur: {{ filters.sender }}
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({sender: ''})) }}" aria-label="Retirer le filtre interlocuteur">×</a>
                    </span>
                {% endif %}
                {% if selectedStatuses|length > 0 %}
                    {% for status in selectedStatuses %}
                        <span class="filter-chip">
                            {{ statusLabels[status]|default(status) }}
                            <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({status: selectedStatuses|filter(value => value != status)})) }}" aria-label="Retirer le filtre statut">×</a>
                        </span>
                    {% endfor %}
                {% endif %}
                {% if selectedDirections|length > 0 %}
                    {% for direction in selectedDirections %}
                        <span class="filter-chip">
                            {{ directionLabels[direction]|default(direction) }}
                            <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({direction: selectedDirections|filter(value => value != direction)})) }}" aria-label="Retirer le filtre nature">×</a>
                        </span>
                    {% endfor %}
                {% endif %}
                {% if filters.dateFrom|default('') or filters.dateTo|default('') %}
                    <span class="filter-chip">
                        {% if filters.dateFrom|default('') and filters.dateTo|default('') %}
                            Du {{ filters.dateFrom|date('d/m/Y') }} au {{ filters.dateTo|date('d/m/Y') }}
                        {% elseif filters.dateFrom|default('') %}
                            Depuis le {{ filters.dateFrom|date('d/m/Y') }}
                        {% else %}
                            Jusqu'au {{ filters.dateTo|date('d/m/Y') }}
                        {% endif %}
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({dateFrom: '', dateTo: ''})) }}" aria-label="Retirer le filtre période">×</a>
                    </span>
                {% endif %}
                {% if selectedDueFilter %}
                    <span class="filter-chip">
                        {{ dueFilterLabels[selectedDueFilter]|default(selectedDueFilter) }}
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({dueFilter: ''})) }}" aria-label="Retirer le filtre échéance">×</a>
                    </span>
                {% endif %}
                {% if showAssignedFilter and selectedAssignedUsers|length > 0 %}
                    {% for assignedUser in selectedAssignedUsers %}
                        <span class="filter-chip">
                            Imputé à: {{ assignedUser.fullName }}
                            <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({assignedTo: selectedAssignedToIds|filter(value => value != assignedUser.id)})) }}" aria-label="Retirer le filtre imputation">×</a>
                        </span>
                    {% endfor %}
                {% endif %}
                {% if selectedDestinataire %}
                    <span class="filter-chip">
                        Destinataire: {{ selectedDestinataire.name }}
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({destinataire: ''})) }}" aria-label="Retirer le filtre destinataire">×</a>
                    </span>
                {% endif %}
                {% if filters.pendingDeletion|default('') %}
                    <span class="filter-chip">
                        Suppressions en attente
                        <a class="filter-chip__remove" href="{{ path(listRoute, activeFilterParams|merge({pendingDeletion: ''})) }}" aria-label="Retirer le filtre suppressions en attente">×</a>
                    </span>
                {% endif %}
            </div>
        {% endif %}
    </form>

    {% if selectedDestinataire %}
        <div class="form-panel" style="margin-bottom: 16px;">
            <div class="topbar" style="margin-bottom: 0;">
                <div>
                    <strong>Filtre destinataire actif</strong>
                    <p>Courriers liés à {{ selectedDestinataire.name }} comme émetteur ou destinataire.</p>
                </div>
                <a class="button secondary" href="{{ path(listRoute, activeFilterParams|merge({destinataire: ''})) }}">Retirer le filtre</a>
            </div>
        </div>
    {% endif %}

    {% if isPendingDeletionView %}
        <div class="form-panel" style="margin-bottom: 16px;">
            <strong>Demandes de suppression en attente</strong>
            <p>Ces courriers sont masqués aux autres utilisateurs jusqu'à l'approbation ou au refus par un administrateur.</p>
        </div>
    {% endif %}

    {% set paginationParams = filters|merge({
        q: filters.q|default(''),
        sender: filters.sender|default(''),
        status: selectedStatuses,
        direction: selectedDirections,
        dateFrom: filters.dateFrom|default(''),
        dateTo: filters.dateTo|default(''),
        dueFilter: selectedDueFilter,
        assignedTo: selectedAssignedToIds,
        destinataire: filters.destinataire|default(''),
        pendingDeletion: filters.pendingDeletion|default('')
    }) %}

    <div class="table-wrap is-colorful" data-loading-skeleton>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Référence</th>
                    <th>Nature</th>
                    <th>Objet</th>
                    <th>Interlocuteur</th>
                    <th>Échéance</th>
                    <th>Statut</th>
                    <th class="table-actions-heading">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for courrier in courriers %}
                <tr>
                    <td data-label="Date">{{ courrier.mailDate|date('d/m/Y') }}</td>
                    <td data-label="Référence">
                        <span class="cell-truncate">{{ courrier.reference }}</span>
                        {% if courrier.deletionPending %}
                            <span class="badge pending-deletion">Suppression en attente</span>
                        {% endif %}
                    </td>
                    <td data-label="Nature">{{ directionLabels[courrier.direction]|default(courrier.directionLabel) }}</td>
                    <td class="table-cell--long" data-label="Objet">
                        <a href="{{ path('app_courrier_show', {id: courrier.id}) }}" title="{{ courrier.subject }}">
                            <strong class="cell-truncate">{{ courrier.subject }}</strong>
                        </a>
                    </td>
                    <td class="table-cell--long" data-label="Interlocuteur"><span class="cell-truncate">{{ courrier.interlocuteurLabel }}</span></td>
                    <td data-label="Échéance">
                        {% if courrier.responseDueAt %}
                            {% set dueTimestamp = courrier.responseDueAt|date('U') %}
                            {% set todayTimestamp = 'today'|date('U') %}
                            {% set dueState = dueTimestamp < todayTimestamp ? 'is-overdue' : (dueTimestamp == todayTimestamp ? 'is-today' : '') %}
                            <span class="record-due {{ dueState }}">{{ courrier.responseDueAt|date('d/m/Y') }}</span>
                        {% else %}
                            <span class="muted">Non renseignée</span>
                        {% endif %}
                    </td>
                    <td data-label="Statut"><span class="badge {{ courrier.status }}">{{ statusLabels[courrier.status]|default(courrier.statusLabel) }}</span></td>
                    <td class="table-actions-cell" data-label="Actions">
                        <div class="row-actions">
                            <a class="button compact icon-only action-view" href="{{ path('app_courrier_show', {id: courrier.id}) }}" title="Afficher" aria-label="Afficher le courrier {{ courrier.reference }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                            {% if is_granted('ROLE_COURRIER_EDIT') and not courrier.deletionPending %}
                                <a class="button compact icon-only action-edit" href="{{ path('app_courrier_edit', {id: courrier.id}) }}" title="Modifier" aria-label="Modifier le courrier {{ courrier.reference }}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 20h9"/>
                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                                    </svg>
                                </a>
                            {% endif %}
                            {% if courrier.attachmentFilename %}
                                <a class="button compact icon-only action-file" href="{{ path('app_courrier_attachment', {id: courrier.id}) }}" target="_blank" title="Ouvrir le fichier" aria-label="Ouvrir le fichier joint du courrier {{ courrier.reference }}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <path d="M14 2v6h6"/>
                                        <path d="M9 15h6"/>
                                        <path d="M9 18h4"/>
                                    </svg>
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="8">
                        <div class="empty-state empty-state--table">
                            <span class="empty-state__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5z"/>
                                    <path d="m8 9 4 3 4-3"/>
                                    <path d="M8 15h8"/>
                                </svg>
                            </span>
                            <h2>
                                {% if isPendingDeletionView %}
                                    Aucune suppression en attente
                                {% elseif isMineView %}
                                    Aucun courrier imputé
                                {% else %}
                                    Aucun courrier trouvé
                                {% endif %}
                            </h2>
                            <p>{{ emptyMessage }}</p>
                            <div class="actions">
                                {% if hasActiveFilters %}
                                    <a class="button secondary" href="{{ path(listRoute) }}">Réinitialiser les filtres</a>
                                {% endif %}
                                {% if is_granted('ROLE_COURRIER_EDIT') and not isPendingDeletionView %}
                                    <a class="button" href="{{ path('app_courrier_new') }}">Créer un courrier</a>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pagination">
            <span>
                {{ pagination.total }} courrier{{ pagination.total > 1 ? 's' : '' }}
                - page {{ pagination.page }} / {{ pagination.totalPages }}
            </span>
            <div class="actions">
                {% if pagination.page > 1 %}
                    <a class="button secondary" href="{{ path(listRoute, paginationParams|merge({page: pagination.page - 1})) }}">Précédent</a>
                {% endif %}
                {% if pagination.page < pagination.totalPages %}
                    <a class="button secondary" href="{{ path(listRoute, paginationParams|merge({page: pagination.page + 1})) }}">Suivant</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
