{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <div class="topbar page-band">
        <div>
            <h1>{{ title }}</h1>
        </div>
        <div class="actions">
            <a class="button secondary" href="{{ path('app_courrier_index') }}">Retour</a>
        </div>
    </div>

    <div class="form-panel courrier-form-panel">
        {{ form_start(form, {attr: {'data-courrier-form': 'true', class: 'professional-form'}}) }}
            {{ form_errors(form) }}
            <section class="form-section">
                <div class="form-section__header">
                    <h2>Identification</h2>
                </div>
                <div class="form-grid">
                    <div>{{ form_row(form.reference) }}</div>
                    <div>
                        {{ form_label(form.replyTo) }}
                        {{ form_errors(form.replyTo) }}
                        {{ form_widget(form.replyTo, {
                            attr: {
                                class: 'reply-to-select sr-only-select',
                                'data-autocomplete-select': 'true',
                                'data-placeholder': 'Rechercher une référence'
                            }
                        }) }}
                    </div>
                    <div>{{ form_row(form.mailDate) }}</div>
                    <div>
                        {{ form_label(form.direction) }}
                        {{ form_widget(form.direction, {attr: {'data-direction-field': 'true'}}) }}
                        {{ form_errors(form.direction) }}
                    </div>
                    <div class="full">
                        {{ form_label(form.status) }}
                        {{ form_errors(form.status) }}
                        {{ form_widget(form.status, {
                            attr: {
                                class: 'sr-only-select',
                                'data-status-select': 'true'
                            }
                        }) }}
                        <div class="status-choice-group" role="group" aria-label="Statut du courrier">
                            {% for choice in form.status.vars.choices %}
                                {% set isSelected = form.status.vars.value == choice.value %}
                                <button
                                    class="status-choice status-choice--{{ choice.value }} {{ isSelected ? 'is-selected' : '' }}"
                                    type="button"
                                    data-status-choice="{{ choice.value }}"
                                    {{ form.status.vars.disabled ? 'disabled' : '' }}
                                    aria-pressed="{{ isSelected ? 'true' : 'false' }}"
                                >
                                    {{ choice.label }}
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="form-section__header">
                    <h2>Contacts</h2>
                </div>
                <div class="form-grid">
                    <div data-visible-for="entrant">
                        {{ form_label(form.senderContact) }}
                        {{ form_errors(form.senderContact) }}
                        {{ form_widget(form.senderContact, {
                            attr: {
                                class: 'single-emetteur-select sr-only-select',
                                'data-autocomplete-select': 'true',
                                'data-placeholder': 'Rechercher un émetteur'
                            }
                        }) }}
                    </div>
                    <div data-visible-for="sortant">
                        {{ form_label(form.destinataires) }}
                        {{ form_errors(form.destinataires) }}
                        {{ form_widget(form.destinataires, {
                            attr: {
                                class: 'multi-destinataire-select sr-only-select',
                                'data-autocomplete-select': 'true',
                                'data-placeholder': 'Rechercher un destinataire'
                            }
                        }) }}
                    </div>
                    <div>
                        {{ form_label(form.assignedTo) }}
                        {{ form_errors(form.assignedTo) }}
                        {{ form_widget(form.assignedTo, {
                            attr: {
                                class: 'multi-imputation-select sr-only-select',
                                'data-autocomplete-select': 'true',
                                'data-placeholder': 'Rechercher une personne'
                            }
                        }) }}
                    </div>
                    <div>{{ form_row(form.responseDueAt) }}</div>
                </div>
            </section>

            <section class="form-section">
                <div class="form-section__header">
                    <h2>Contenu</h2>
                </div>
                <div class="form-grid">
                    <div class="full">{{ form_row(form.subject) }}</div>
                    <div class="full">{{ form_row(form.content) }}</div>
                    <div class="full">{{ form_row(form.responseNotes) }}</div>
                    <div class="full">{{ form_row(form.localisation) }}</div>
                    <div class="full">
                        {{ form_label(form.attachment) }}
                        {{ form_errors(form.attachment) }}
                        <div class="upload-dropzone" data-upload-dropzone>
                            {{ form_widget(form.attachment, {
                                attr: {
                                    class: 'upload-dropzone__input',
                                    'data-upload-input': 'true'
                                }
                            }) }}
                            <span class="upload-dropzone__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                    <path d="M17 8 12 3 7 8"/>
                                    <path d="M12 3v12"/>
                                </svg>
                            </span>
                            <span class="upload-dropzone__text">
                                <strong>Déposer une pièce jointe</strong>
                                <small data-upload-filename>PDF ou image, 10 Mo maximum</small>
                            </span>
                        </div>
                        {% if courrier.attachmentFilename %}
                            <p class="current-file">Pièce actuelle: <a href="{{ path('app_courrier_attachment', {id: courrier.id}) }}" target="_blank">{{ courrier.attachmentFilename }}</a></p>
                        {% endif %}
                    </div>
                </div>
            </section>
            <div class="form-actions">
                <button type="submit">{{ button_label }}</button>
                <a class="button secondary" href="{{ path('app_courrier_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
