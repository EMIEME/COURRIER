                                <span class="notification-center__label">Notifications</span>
                                {% if notificationCenter.count > 0 %}
                                    <span class="notification-badge">{{ notificationCenter.count > 99 ? '99+' : notificationCenter.count }}</span>
                                {% endif %}
                            </summary>
                            <div class="notification-panel">
                                <div class="notification-panel__head">
                                    <strong>Notifications</strong>
                                    {% if notificationCenter.count > 0 %}
                                        <span class="badge">{{ notificationCenter.count }}</span>
                                    {% endif %}
                                </div>
                                {% for notification in notificationCenter.items %}
                                    <article class="notification-item notification-item--{{ notification.severity }} notification-item--{{ notification.read ? 'read' : 'unread' }}">
                                        <a class="notification-item__link" href="{{ path(notification.route, notification.routeParams) }}">
                                            <strong>{{ notification.title }}</strong>
                                            <p>{{ notification.message }}</p>
                                        </a>
                                        {% if notification.id %}
                                            <div class="notification-item__actions">
                                                {% if notification.read %}
                                                    <form method="post" action="{{ path('app_notification_mark_unread', {id: notification.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('notification-unread' ~ notification.id) }}">
                                                        <button class="notification-toggle" type="submit">Marquer non lue</button>
                                                    </form>
                                                {% else %}
                                                    <form method="post" action="{{ path('app_notification_mark_read', {id: notification.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('notification-read' ~ notification.id) }}">
                                                        <button class="notification-toggle" type="submit">Marquer lue</button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </article>
                                {% else %}
                                    <p class="notification-empty">Aucune notification active.</p>
                                {% endfor %}
                            </div>
                        </details>
                        <nav class="nav" aria-label="Navigation principale">
                            {% if is_granted('ROLE_COURRIER_VIEW') or is_granted('ROLE_COURRIER_EDIT') %}
                                <div class="nav__section">
                                    <span class="nav__section-label">Courriers</span>
                                    {% if is_granted('ROLE_COURRIER_VIEW') %}
                                        <a class="{{ currentRoute == 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="3" y="3" width="7" height="7"/>
                                                    <rect x="14" y="3" width="7" height="7"/>
                                                    <rect x="14" y="14" width="7" height="7"/>
                                                    <rect x="3" y="14" width="7" height="7"/>
                                                </svg>
                                            </span>
                                            <span>Tableau de bord</span>
                                        </a>
                                    {% endif %}
                                    {% if is_granted('ROLE_COURRIER_EDIT') %}
                                        <a class="{{ currentRoute == 'app_courrier_new' ? 'active' : '' }}" href="{{ path('app_courrier_new') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M14 3v5a2 2 0 0 0 2 2h5"/>
                                                    <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l7 7v9a2 2 0 0 1-2 2z"/>
                                                    <path d="M12 12v6"/>
                                                    <path d="M9 15h6"/>
                                                </svg>
                                            </span>
                                            <span>Nouveau courrier</span>
                                        </a>
                                    {% endif %}
                                    {% if is_granted('ROLE_COURRIER_VIEW') %}
                                        <a class="{{ currentRoute in ['app_courrier_index', 'app_courrier_show', 'app_courrier_edit'] ? 'active' : '' }}" href="{{ path('app_courrier_index') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="11" cy="11" r="7"/>
                                                    <path d="m16.5 16.5 4 4"/>
                                                    <path d="M8 11h6"/>
                                                </svg>
                                            </span>
                                            <span>Rechercher</span>
                                        </a>
                                        <a class="{{ currentRoute == 'app_courrier_mine' ? 'active' : '' }}" href="{{ path('app_courrier_mine') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 4h16v16H4z"/>
                                                    <path d="M8 4v6h8V4"/>
                                                    <path d="M8 15h8"/>
                                                </svg>
                                            </span>
                                            <span>Mes courriers</span>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                            {% if is_granted('ROLE_SECRETARIAT') or is_granted('ROLE_ADMIN') %}
                                <div class="nav__section">
                                    <span class="nav__section-label">Référentiels</span>
                                    {% if is_granted('ROLE_SECRETARIAT') %}
                                        <a class="{{ currentRoute starts with 'app_destinataire_' ? 'active' : '' }}" href="{{ path('app_destinataire_index') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="9" cy="7" r="4"/>
                                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                                </svg>
                                            </span>
                                            <span>Destinataires</span>
                                        </a>
                                    {% endif %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a class="{{ currentRoute starts with 'app_list_option_' ? 'active' : '' }}" href="{{ path('app_list_option_index') }}">
                                            <span class="nav__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                                                    <path d="M19.4 15a1.8 1.8 0 0 0 .36 1.98l.05.05a2.1 2.1 0 0 1-2.97 2.97l-.05-.05a1.8 1.8 0 0 0-1.98-.36 1.8 1.8 0 0 0-1.09 1.65V21a2.1 2.1 0 0 1-4.2 0v-.07a1.8 1.8 0 0 0-1.09-1.65 1.8 1.8 0 0 0-1.98.36l-.05.05a2.1 2.1 0 0 1-2.97-2.97l.05-.05A1.8 1.8 0 0 0 4.6 15a1.8 1.8 0 0 0-1.65-1.09H2.9a2.1 2.1 0 0 1 0-4.2h.07A1.8 1.8 0 0 0 4.6 8a1.8 1.8 0 0 0-.36-1.98l-.05-.05A2.1 2.1 0 0 1 7.16 3l.05.05A1.8 1.8 0 0 0 9.2 3.4 1.8 1.8 0 0 0 10.29 1.75V1.7a2.1 2.1 0 0 1 4.2 0v.07A1.8 1.8 0 0 0 15.58 3.4a1.8 1.8 0 0 0 1.98-.36l.05-.05a2.1 2.1 0 0 1 2.97 2.97l-.05.05A1.8 1.8 0 0 0 19.4 8a1.8 1.8 0 0 0 1.65 1.09h.05a2.1 2.1 0 0 1 0 4.2h-.07A1.8 1.8 0 0 0 19.4 15z"/>
                                                </svg>
                                            </span>
                                            <span>Listes</span>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="nav__section">
                                    <span class="nav__section-label">Administration</span>
                                    <a class="{{ currentRoute starts with 'app_user_' ? 'active' : '' }}" href="{{ path('app_user_index') }}">
                                        <span class="nav__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                                <circle cx="8.5" cy="7" r="4"/>
                                                <path d="M20 8v6"/>
                                                <path d="M23 11h-6"/>
                                            </svg>
                                        </span>
                                        <span>Utilisateurs</span>
                                    </a>
                                </div>
                            {% endif %}
                        </nav>
                        <div class="user-box">
                            <strong>{{ app.user.fullName }}</strong><br>
                            <span>{{ app.user.email }}</span>
                            <div style="margin-top: 14px;">
                                <a class="button secondary" href="{{ path('app_logout') }}">Déconnexion</a>
                            </div>
                        </div>
                    </div>
                </aside>
            {% endif %}
            <main class="main">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash {{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
