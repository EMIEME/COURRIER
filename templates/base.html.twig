<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Gestion Courrier{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%230b6b3a%22/><path d=%22M30 44a12 12 0 0 1 12-12h44a12 12 0 0 1 12 12v40a12 12 0 0 1-12 12H42a12 12 0 0 1-12-12z%22 fill=%22%23fff4e8%22/><path d=%22M38 48l26 20 26-20%22 fill=%22none%22 stroke=%22%23d66a00%22 stroke-width=%228%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/></svg>">
        {% block stylesheets %}
            <style>
                :root {
                    color-scheme: light;
                    --bg: #f7f8f3;
                    --panel: #ffffff;
                    --panel-soft: #eef5eb;
                    --border: #d9e3d5;
                    --text: #16221b;
                    --muted: #637268;
                    --primary: #0b6b3a;
                    --primary-strong: #074f2a;
                    --accent: #d66a00;
                    --accent-strong: #a94f00;
                    --success: #19723c;
                    --warning: #c66b00;
                    --shadow: 0 12px 30px rgba(31, 54, 37, 0.09);
                }

                * { box-sizing: border-box; }

                body {
                    margin: 0;
                    min-height: 100vh;
                    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                    background: var(--bg);
                    color: var(--text);
                    letter-spacing: 0;
                }

                a { color: inherit; text-decoration: none; }

                .app-shell {
                    display: grid;
                    grid-template-columns: 250px 1fr;
                    min-height: 100vh;
                }

                .app-shell--guest {
                    display: block;
                    min-height: 100vh;
                }

                .app-shell--guest .main {
                    min-height: 100vh;
                    padding: 0;
                }

                .sidebar {
                    background: #123326;
                    color: #f7fbf6;
                    display: flex;
                    flex-direction: column;
                    height: 100vh;
                    overflow-y: auto;
                    padding: 24px 16px;
                    position: sticky;
                    top: 0;
                }

                .sidebar__head {
                    align-items: center;
                    display: flex;
                    gap: 12px;
                    justify-content: space-between;
                    margin-bottom: 26px;
                }

                .sidebar__content {
                    display: flex;
                    flex: 1;
                    flex-direction: column;
                    min-height: 0;
                }

                .brand {
                    align-items: center;
                    display: flex;
                    gap: 10px;
                    font-size: 22px;
                    font-weight: 800;
                    letter-spacing: 0;
                    margin-bottom: 26px;
                    padding: 0 8px;
                }

                .sidebar__head .brand {
                    margin-bottom: 0;
                    min-width: 0;
                    padding: 0;
                }

                .brand span:last-child {
                    min-width: 0;
                }

                .brand__mark {
                    align-items: center;
                    background: #fff1df;
                    border-radius: 8px;
                    color: var(--primary-strong);
                    display: inline-flex;
                    flex: 0 0 34px;
                    height: 34px;
                    justify-content: center;
                    width: 34px;
                }

                .mobile-nav-toggle {
                    align-items: center;
                    background: rgba(255, 255, 255, 0.1);
                    border: 1px solid rgba(255, 255, 255, 0.18);
                    border-radius: 8px;
                    color: #f7fbf6;
                    cursor: pointer;
                    display: none;
                    flex: 0 0 auto;
                    font-size: 14px;
                    font-weight: 800;
                    gap: 8px;
                    min-height: 40px;
                    padding: 9px 12px;
                }

                .mobile-nav-toggle:hover,
                .mobile-nav-toggle:focus-visible {
                    background: #fff4e8;
                    color: var(--primary-strong);
                    outline: none;
                }

                .mobile-nav-toggle svg {
                    display: block;
                    height: 18px;
                    stroke: currentColor;
                    width: 18px;
                }

                .notification-center {
                    margin-bottom: 14px;
                    position: relative;
                }

                .notification-center summary {
                    align-items: center;
                    background: rgba(255, 255, 255, 0.1);
                    border: 1px solid rgba(255, 255, 255, 0.16);
                    border-radius: 8px;
                    color: #f7fbf6;
                    cursor: pointer;
                    display: flex;
                    gap: 10px;
                    list-style: none;
                    min-height: 44px;
                    padding: 9px 10px;
                    user-select: none;
                }

                .notification-center summary::-webkit-details-marker { display: none; }
                .notification-center[open] summary {
                    background: #fff4e8;
                    color: var(--primary-strong);
                }

                .notification-center__icon {
                    align-items: center;
                    background: rgba(255, 255, 255, 0.12);
                    border-radius: 8px;
                    display: inline-flex;
                    flex: 0 0 30px;
                    height: 30px;
                    justify-content: center;
                    width: 30px;
                }

                .notification-center[open] .notification-center__icon {
                    background: rgba(214, 106, 0, 0.14);
                }

                .notification-center__icon svg {
                    display: block;
                    height: 18px;
                    stroke: currentColor;
                    width: 18px;
                }

                .notification-center__label {
                    flex: 1;
                    font-weight: 750;
                    min-width: 0;
                }

                .notification-badge {
                    align-items: center;
                    background: var(--accent);
                    border-radius: 999px;
                    color: #fff;
                    display: inline-flex;
                    flex: 0 0 auto;
                    font-size: 12px;
                    font-weight: 850;
                    justify-content: center;
                    min-width: 24px;
                    padding: 3px 7px;
                }

                .notification-panel {
                    background: #fff;
                    border: 1px solid #d7e4d1;
                    border-radius: 8px;
                    box-shadow: 0 16px 36px rgba(14, 32, 22, 0.24);
                    color: var(--text);
                    display: grid;
                    gap: 8px;
                    margin-top: 8px;
                    max-height: 360px;
                    overflow: auto;
                    padding: 10px;
                }

                .notification-panel__head {
                    align-items: center;
                    display: flex;
                    gap: 8px;
                    justify-content: space-between;
                    padding: 2px 2px 8px;
                }

                .notification-panel__head strong {
                    color: var(--primary-strong);
                    font-size: 14px;
                }

                .notification-item {
                    border: 1px solid var(--border);
                    border-left: 4px solid var(--primary);
                    border-radius: 8px;
                    display: grid;
                    gap: 4px;
                    padding: 10px;
                }

                .notification-item--read {
                    opacity: 0.72;
                }

                .notification-item--unread {
                    background: #fffdf8;
                }

                .notification-item:hover {
                    background: #fbfdf9;
                    border-color: #bdd2b6;
                }

                .notification-item--warning { border-left-color: var(--warning); }
                .notification-item--danger { border-left-color: var(--accent); }

                .notification-item__link {
                    color: inherit;
                    display: grid;
                    gap: 4px;
                    text-decoration: none;
                }

                .notification-item strong {
                    color: var(--text);
                    font-size: 14px;
                }
                .notification-item p {
                    color: var(--muted);
                    font-size: 12px;
                    line-height: 1.45;
                }

                .notification-item__actions {
                    display: flex;
                    justify-content: flex-end;
                    margin-top: 4px;
                }

                .notification-item__actions form {
                    margin: 0;
                }

                .notification-toggle {
                    background: transparent;
                    border: 0;
                    color: var(--primary-strong);
                    cursor: pointer;
                    font-size: 12px;
                    font-weight: 750;
                    padding: 0;
                }

                .notification-toggle:hover {
                    text-decoration: underline;
                }

                .notification-empty {
                    background: #f7faf4;
                    border: 1px dashed #cfe0c8;
                    border-radius: 8px;
                    color: var(--muted);
                    font-size: 13px;
                    padding: 12px;
                }

                .nav { display: grid; gap: 18px; }

                .nav__section {
                    display: grid;
                    gap: 6px;
                }

                .nav__section-label {
                    color: rgba(247, 251, 246, 0.62);
                    font-size: 11px;
                    font-weight: 850;
                    letter-spacing: 0.08em;
                    padding: 0 12px 2px;
                    text-transform: uppercase;
                }

                .nav a {
                    align-items: center;
                    border-radius: 8px;
                    display: flex;
                    gap: 10px;
                    color: #dfebe2;
                    min-height: 44px;
                    padding: 10px 12px;
                    font-weight: 650;
                    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
                }

                .nav a:hover, .nav a.active {
                    background: rgba(255, 255, 255, 0.12);
                    color: #fff;
                    transform: translateX(2px);
                }

                .nav a.active {
                    background: #fff4e8;
                    color: var(--primary-strong);
                    box-shadow: 0 10px 22px rgba(14, 32, 22, 0.18);
                }

                .nav__icon {
                    align-items: center;
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 8px;
                    display: inline-flex;
                    flex: 0 0 30px;
                    height: 30px;
                    justify-content: center;
                    width: 30px;
                }

                .nav a.active .nav__icon {
                    background: rgba(214, 106, 0, 0.14);
                }

                .nav__icon svg, .brand__mark svg {
                    display: block;
                    height: 18px;
                    stroke: currentColor;
                    width: 18px;
                }

                .user-box {
                    border-top: 1px solid rgba(255, 255, 255, 0.16);
                    margin-top: auto;
                    padding-top: 18px;
                    color: #d8e6dc;
                    font-size: 14px;
                }

                .main { padding: 28px; min-width: 0; }
                .breadcrumbs {
                    align-items: center;
                    color: var(--muted);
                    display: flex;
                    flex-wrap: wrap;
                    font-size: 13px;
                    font-weight: 800;
                    gap: 8px;
                    margin: 0 0 12px;
                }
                .breadcrumbs a {
                    color: var(--primary-strong);
                }
                .breadcrumbs span[aria-current="page"] {
                    color: var(--text);
                }
                .breadcrumbs__separator {
                    color: #9aad9d;
                    font-weight: 700;
                }
                .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 22px; }
                .page-band {
                    background: #edf7e9;
                    border: 1px solid #cfe7c8;
                    border-left: 6px solid var(--primary);
                    border-radius: 8px;
                    box-shadow: var(--shadow);
                    padding: 18px;
                }
                .page-band h1 { color: var(--primary-strong); }
                .page-band p { color: #52645a; }
                .page-band__meta {
                    align-items: center;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    margin-top: 10px;
                }
                .page-band__meta-item {
                    background: rgba(255, 255, 255, 0.72);
                    border: 1px solid #d6e8cf;
                    border-radius: 999px;
                    color: #4d604f;
                    display: inline-flex;
                    font-size: 12px;
                    font-weight: 850;
                    min-height: 28px;
                    padding: 5px 10px;
                }
                h1 { margin: 0; font-size: 30px; line-height: 1.15; }
                h2 { margin: 0 0 14px; font-size: 20px; }
                p { margin: 0; color: var(--muted); }

                .actions { display: flex; gap: 10px; flex-wrap: wrap; }
                .button, button {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    min-height: 40px;
                    border: 0;
                    border-radius: 8px;
                    background: var(--primary);
                    color: #fff;
                    cursor: pointer;
                    font: inherit;
                    font-weight: 750;
                    padding: 10px 14px;
                }

                .button.secondary, button.secondary { background: #e7ece2; color: #1e2d23; }
                .button.danger, button.danger { background: var(--accent); }
                .button.action-view { background: var(--primary); color: #fff; }
                .button.action-edit { background: #e8f3e3; color: var(--primary-strong); }
                .button.action-file { background: #fff0dc; color: #875000; }
                .button.compact, button.compact {
                    font-size: 13px;
                    min-height: 32px;
                    padding: 7px 10px;
                }
                .button.icon-only {
                    min-width: 34px;
                    padding: 7px;
                }
                .button svg {
                    height: 17px;
                    stroke: currentColor;
                    width: 17px;
                }
                .button:hover, button:hover { background: var(--primary-strong); }
                .button.action-edit:hover { background: #d6eacb; color: var(--primary-strong); }
                .button.action-file:hover { background: #f6d6a9; color: #6b3f00; }

                .grid { display: grid; gap: 16px; }
                .grid.stats { grid-template-columns: repeat(6, minmax(130px, 1fr)); margin-bottom: 18px; }
                .grid.two { grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr); }
                .dashboard-courriers-grid {
                    grid-template-columns: minmax(0, 2.4fr) minmax(260px, 0.6fr);
                }

                .card, .table-wrap, .form-panel {
                    background: var(--panel);
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    box-shadow: var(--shadow);
                }

                .card { padding: 18px; }
                .stat {
                    border-left: 5px solid var(--primary);
                    color: var(--text);
                    display: grid;
                    gap: 14px;
                    min-height: 118px;
                    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
                }
                .stat:hover, .stat.active { transform: translateY(-1px); }
                .stat--received { border-left-color: var(--primary); background: #edf7e9; }
                .stat--sent { border-left-color: var(--accent); background: #fff3e2; }
                .stat--internal { border-left-color: #6f7f2c; background: #f4f6e6; }
                .stat--progress { border-left-color: #1d4ed8; background: #eff6ff; }
                .stat--done { border-left-color: var(--success); background: #edf8f1; }
                .stat--urgent { border-left-color: #b42318; background: #fff1f1; }
                .stat.active { box-shadow: 0 0 0 2px rgba(214, 106, 0, 0.2), var(--shadow); }
                .stat__head {
                    align-items: flex-start;
                    display: flex;
                    gap: 10px;
                    justify-content: space-between;
                }
                .stat__label {
                    color: var(--muted);
                    font-weight: 750;
                    line-height: 1.25;
                }
                .stat__icon {
                    align-items: center;
                    border-radius: 8px;
                    display: inline-flex;
                    flex: 0 0 34px;
                    height: 34px;
                    justify-content: center;
                    width: 34px;
                }
                .stat__icon svg {
                    display: block;
                    height: 18px;
                    stroke: currentColor;
                    width: 18px;
                }
                .stat strong { color: var(--text); display: block; font-size: 32px; line-height: 1; }
                .stat--received .stat__icon { background: rgba(11, 107, 58, 0.12); color: var(--primary-strong); }
                .stat--sent .stat__icon { background: rgba(214, 106, 0, 0.13); color: var(--accent-strong); }
                .stat--internal .stat__icon { background: rgba(111, 127, 44, 0.13); color: #536017; }
                .stat--progress .stat__icon { background: rgba(37, 99, 235, 0.12); color: #1d4ed8; }
                .stat--done .stat__icon { background: rgba(25, 114, 60, 0.12); color: var(--success); }
                .stat--urgent .stat__icon { background: rgba(180, 35, 24, 0.12); color: #b42318; }
                .stat--progress.active { box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.24), var(--shadow); }
                .stat--urgent.active { box-shadow: 0 0 0 2px rgba(180, 35, 24, 0.22), var(--shadow); }

                .table-wrap {
                    position: relative;
                    overflow: auto;
                    max-width: 100%;
                }
                .table-wrap.is-colorful {
                    border-color: #cfe0c8;
                    box-shadow: 0 16px 36px rgba(21, 72, 39, 0.11);
                }
                table { border-collapse: collapse; width: 100%; min-width: 780px; }
                th, td { border-bottom: 1px solid var(--border); padding: 13px 14px; text-align: left; vertical-align: top; }
                th {
                    background: #fff;
                    color: var(--muted);
                    font-size: 13px;
                    position: sticky;
                    text-transform: uppercase;
                    top: 0;
                    z-index: 2;
                }
                tr:last-child td { border-bottom: 0; }
                .table-wrap.is-colorful thead th {
                    background: var(--primary);
                    border-bottom: 0;
                    color: #f8fff8;
                }
                .table-wrap.is-colorful tbody tr:nth-child(even) { background: #fbfdf9; }
                .table-wrap.is-colorful tbody tr:hover { background: #f1f7ec; }
                .table-wrap.is-colorful td:first-child { border-left: 4px solid #f0b464; }
                .table-cell--long {
                    max-width: clamp(220px, 28vw, 380px);
                }
                .cell-truncate {
                    display: block;
                    max-width: clamp(180px, 26vw, 360px);
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .table-actions-heading,
                .table-actions-cell {
                    white-space: nowrap;
                    width: 1%;
                }
                .table-empty-row td {
                    border-left: 0 !important;
                    padding: 0;
                }
                .pagination {
                    align-items: center;
                    background: #fff;
                    border-top: 1px solid var(--border);
                    display: flex;
                    justify-content: space-between;
                    gap: 12px;
                    min-width: 780px;
                    padding: 12px 14px;
                }

                .pagination span { color: var(--muted); font-weight: 700; }
                .row-actions {
                    display: flex;
                    flex-wrap: nowrap;
                    gap: 6px;
                    min-width: 0;
                    width: max-content;
                }
                .row-actions form {
                    display: inline-flex;
                    margin: 0;
                }

                .empty-state {
                    align-items: center;
                    background: #fbfdf9;
                    border: 1px dashed #bfd4b7;
                    border-radius: 8px;
                    display: grid;
                    gap: 10px;
                    justify-items: center;
                    padding: 30px 18px;
                    text-align: center;
                }
                .empty-state--table {
                    background: linear-gradient(180deg, #fbfdf9, #fff);
                    border: 0;
                    border-radius: 0;
                    padding: 38px 18px;
                }
                .empty-state--compact {
                    justify-items: start;
                    padding: 18px;
                    text-align: left;
                }
                .empty-state__icon {
                    align-items: center;
                    background: #edf7e9;
                    border-radius: 8px;
                    color: var(--primary-strong);
                    display: inline-flex;
                    height: 44px;
                    justify-content: center;
                    width: 44px;
                }
                .empty-state__icon svg {
                    display: block;
                    height: 22px;
                    stroke: currentColor;
                    width: 22px;
                }
                .empty-state h2,
                .empty-state h3 {
                    color: var(--text);
                    font-size: 18px;
                    margin: 0;
                }
                .empty-state p {
                    line-height: 1.55;
                    max-width: 520px;
                }
                .empty-state .actions {
                    justify-content: center;
                    margin-top: 4px;
                }
                .empty-state--compact .actions {
                    justify-content: flex-start;
                }

                [data-loading-skeleton] {
                    position: relative;
                }
                body.is-page-loading {
                    cursor: progress;
                }
                body.is-page-loading [data-loading-skeleton] {
                    min-height: 118px;
                    overflow: hidden;
                }
                body.is-page-loading [data-loading-skeleton] > * {
                    opacity: 0;
                    pointer-events: none;
                }
                body.is-page-loading [data-loading-skeleton]::after {
                    animation: skeleton-shimmer 1.2s linear infinite;
                    background: linear-gradient(90deg, #edf3e9 0%, #fbfdf9 45%, #edf3e9 90%);
                    background-size: 220% 100%;
                    border-radius: 8px;
                    content: '';
                    inset: 16px;
                    position: absolute;
                }
                body.is-page-loading .table-wrap[data-loading-skeleton] {
                    min-height: 360px;
                }
                body.is-page-loading .stat[data-loading-skeleton] {
                    min-height: 118px;
                }
                @keyframes skeleton-shimmer {
                    0% { background-position: 120% 0; }
                    100% { background-position: -120% 0; }
                }

                .badge {
                    display: inline-flex;
                    align-items: center;
                    border-radius: 999px;
                    font-size: 12px;
                    font-weight: 800;
                    padding: 5px 9px;
                    background: var(--panel-soft);
                    color: #2a3d30;
                    white-space: nowrap;
                }

                .badge.urgent { background: #ffe7d0; color: #9a3900; }
                .badge.traite { background: #dff3e8; color: var(--success); }
                .badge.en_cours { background: #fff2cf; color: var(--warning); }
                .badge.pending-deletion { background: #fde2e2; color: #9d1f1f; }

                .filters, .form-grid {
                    display: grid;
                    grid-template-columns: repeat(4, minmax(160px, 1fr));
                    gap: 12px;
                }

                .filter-panel {
                    display: grid;
                    gap: 14px;
                    margin-bottom: 16px;
                }
                .filter-primary {
                    align-items: end;
                    display: grid;
                    gap: 12px;
                    grid-template-columns: minmax(260px, 1fr) auto;
                }
                .filter-primary--period {
                    grid-template-columns: repeat(2, minmax(180px, 1fr)) auto;
                }
                .filter-primary input {
                    font-size: 16px;
                    min-height: 48px;
                }
                .filter-actions {
                    align-items: center;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                }
                .filter-advanced {
                    border-top: 1px solid var(--border);
                    padding-top: 12px;
                }
                .filter-advanced summary {
                    align-items: center;
                    color: var(--primary-strong);
                    cursor: pointer;
                    display: inline-flex;
                    font-weight: 850;
                    gap: 8px;
                    list-style: none;
                    user-select: none;
                }
                .filter-advanced summary::-webkit-details-marker { display: none; }
                .filter-advanced summary::before {
                    content: '+';
                    font-size: 18px;
                    line-height: 1;
                }
                .filter-advanced[open] summary::before {
                    content: '-';
                }
                .filter-advanced__grid {
                    display: grid;
                    gap: 12px;
                    grid-template-columns: repeat(4, minmax(160px, 1fr));
                    margin-top: 12px;
                }
                .filter-chips {
                    align-items: center;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                }
                .filter-chip {
                    align-items: center;
                    background: #fff8ef;
                    border: 1px solid #f1d5ae;
                    border-radius: 999px;
                    color: #5f4a2e;
                    display: inline-flex;
                    font-size: 13px;
                    font-weight: 800;
                    gap: 8px;
                    max-width: 100%;
                    min-height: 30px;
                    overflow-wrap: anywhere;
                    padding: 5px 9px 5px 11px;
                }
                .filter-chip__remove {
                    align-items: center;
                    background: #f1d5ae;
                    border-radius: 999px;
                    color: #4d3415;
                    display: inline-flex;
                    flex: 0 0 auto;
                    font-size: 14px;
                    height: 20px;
                    justify-content: center;
                    line-height: 1;
                    width: 20px;
                }

                .priority-panel {
