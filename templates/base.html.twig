        {% block javascripts %}
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const mobileSidebar = document.querySelector('[data-mobile-sidebar]');
                    const mobileNavToggle = document.querySelector('[data-mobile-nav-toggle]');
                    const mobileNavContent = document.querySelector('[data-mobile-nav-content]');
                    const mobileNavQuery = window.matchMedia('(max-width: 920px)');

                    if (mobileSidebar && mobileNavToggle && mobileNavContent) {
                        const setMobileNavOpen = (isOpen) => {
                            mobileSidebar.classList.toggle('is-open', isOpen);
                            mobileNavToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                            mobileNavToggle.setAttribute('aria-label', isOpen ? 'Fermer la navigation' : 'Ouvrir la navigation');
                        };

                        mobileNavToggle.addEventListener('click', () => {
                            setMobileNavOpen(!mobileSidebar.classList.contains('is-open'));
                        });

                        mobileNavContent.querySelectorAll('a').forEach((link) => {
                            link.addEventListener('click', () => {
                                if (mobileNavQuery.matches) {
                                    setMobileNavOpen(false);
                                }
                            });
                        });

                        const closeWhenDesktop = () => {
                            if (!mobileNavQuery.matches) {
                                setMobileNavOpen(false);
                            }
                        };

                        if (mobileNavQuery.addEventListener) {
                            mobileNavQuery.addEventListener('change', closeWhenDesktop);
                        } else {
                            mobileNavQuery.addListener(closeWhenDesktop);
                        }

                        setMobileNavOpen(false);
                    }

                    const showPageLoading = () => {
                        document.body.classList.add('is-page-loading');
                    };

                    document.body.addEventListener('click', (event) => {
                        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
                        if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                            return;
                        }

                        const href = link.getAttribute('href') || '';
                        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
                            return;
                        }

                        if ((link.target && link.target !== '_self') || link.hasAttribute('download') || link.classList.contains('export-button')) {
                            return;
                        }

                        const url = new URL(link.href, window.location.href);
                        if (url.origin === window.location.origin) {
                            window.setTimeout(showPageLoading, 80);
                        }
                    });

                    document.querySelectorAll('form').forEach((form) => {
                        form.addEventListener('submit', (event) => {
                            if (!event.defaultPrevented && (!form.target || form.target === '_self')) {
                                window.setTimeout(showPageLoading, 80);
                            }
                        });
                    });

                    window.addEventListener('pageshow', () => {
                        document.body.classList.remove('is-page-loading');
                    });

                    document.querySelectorAll('[data-autocomplete-select]').forEach((select) => {
                        if (select.dataset.autocompleteReady === 'true') {
                            return;
                        }

                        select.dataset.autocompleteReady = 'true';

                        const wrapper = document.createElement('div');
                        wrapper.className = 'autocomplete-multi';

                        const chips = document.createElement('div');
                        chips.className = 'autocomplete-multi__chips';

                        const input = document.createElement('input');
                        input.type = 'text';
                        input.className = 'autocomplete-multi__input';
                        input.placeholder = select.dataset.placeholder || 'Rechercher';
                        input.autocomplete = 'off';

                        const results = document.createElement('div');
                        results.className = 'autocomplete-multi__results';

                        wrapper.append(chips, input, results);
                        select.insertAdjacentElement('afterend', wrapper);

                        const options = Array.from(select.options).filter((option) => option.value);
                        const normalize = (value) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                        const showAllOnFocus = select.dataset.autocompleteShowAll === 'true';

                        const selectedOptions = () => options.filter((option) => option.selected);

                        const sync = () => {
                            chips.innerHTML = '';

                            selectedOptions().forEach((option) => {
                                const chip = document.createElement('span');
                                chip.className = 'autocomplete-multi__chip';
                                chip.textContent = option.textContent;

                                const remove = document.createElement('button');
                                remove.type = 'button';
                                remove.setAttribute('aria-label', 'Retirer ' + option.textContent);
                                remove.textContent = 'x';
                                remove.addEventListener('click', () => {
                                    option.selected = false;
                                    sync();
                                    renderResults();
                                    input.focus();
                                });

                                chip.append(remove);
                                chips.append(chip);
                            });
                        };

                        const renderResults = () => {
                            const query = normalize(input.value.trim());
                            if (!query && !showAllOnFocus) {
                                results.innerHTML = '';
                                results.classList.remove('is-open');

                                return;
                            }

                            const matches = options
                                .filter((option) => !option.selected)
                                .filter((option) => !query || normalize(option.textContent).includes(query))
                                .slice(0, 8);

                            results.innerHTML = '';
                            results.classList.toggle('is-open', matches.length > 0);

                            matches.forEach((option) => {
                                const button = document.createElement('button');
                                button.type = 'button';
                                button.className = 'autocomplete-multi__option';
                                button.textContent = option.textContent;
                                button.addEventListener('mousedown', (event) => event.preventDefault());
                                button.addEventListener('click', () => {
                                    option.selected = true;
                                    input.value = '';
                                    sync();
                                    renderResults();
                                    input.focus();
                                });
                                results.append(button);
                            });
                        };

                        input.addEventListener('input', renderResults);
                        input.addEventListener('focus', renderResults);
                        input.addEventListener('keydown', (event) => {
                            if (event.key === 'Escape') {
                                results.classList.remove('is-open');
                            }
                        });
                        document.addEventListener('click', (event) => {
                            if (!wrapper.contains(event.target)) {
                                results.classList.remove('is-open');
                            }
                        });

                        sync();
                    });

                    document.querySelectorAll('[data-status-select]').forEach((select) => {
                        const group = select.parentElement?.querySelector('.status-choice-group');
                        if (!group) {
                            return;
                        }

                        const choices = Array.from(group.querySelectorAll('[data-status-choice]'));
                        const syncStatusChoices = () => {
                            choices.forEach((choice) => {
                                const selected = choice.dataset.statusChoice === select.value;
                                choice.classList.toggle('is-selected', selected);
                                choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
                            });
                        };

                        choices.forEach((choice) => {
                            choice.addEventListener('click', () => {
                                if (select.disabled || choice.disabled) {
                                    return;
                                }

                                select.value = choice.dataset.statusChoice || '';
                                select.dispatchEvent(new Event('change', { bubbles: true }));
                                syncStatusChoices();
                            });
                        });

                        syncStatusChoices();
                    });

                    document.querySelectorAll('[data-upload-dropzone]').forEach((dropzone) => {
                        const input = dropzone.querySelector('[data-upload-input]');
                        const filename = dropzone.querySelector('[data-upload-filename]');
                        if (!input || !filename) {
                            return;
                        }

                        input.addEventListener('change', () => {
                            filename.textContent = input.files && input.files.length > 0
                                ? input.files[0].name
                                : 'PDF ou image, 50 Mo maximum';
                        });

                        ['dragenter', 'dragover'].forEach((eventName) => {
                            dropzone.addEventListener(eventName, () => dropzone.classList.add('is-dragover'));
                        });

                        ['dragleave', 'drop'].forEach((eventName) => {
                            dropzone.addEventListener(eventName, () => {
                                window.setTimeout(() => dropzone.classList.remove('is-dragover'), 80);
                            });
                        });
                    });

                    document.querySelectorAll('[data-courrier-form]').forEach((form) => {
                        const direction = form.querySelector('[data-direction-field]');
                        const senderGroup = form.querySelector('[data-visible-for="entrant"]');
                        const recipientGroup = form.querySelector('[data-visible-for="sortant"]');
                        const updateContactFields = () => {
                            const value = direction ? direction.value : '';
                            const showSender = value === 'entrant';
                            const showRecipients = value === 'sortant' || value === 'note_interne';

                            if (senderGroup) {
                                senderGroup.classList.toggle('is-hidden', !showSender);
                                senderGroup.querySelectorAll('select, input, textarea').forEach((field) => {
                                    field.disabled = !showSender;
                                });
                            }

                            if (recipientGroup) {
                                recipientGroup.classList.toggle('is-hidden', !showRecipients);
                                recipientGroup.querySelectorAll('select, input, textarea').forEach((field) => {
                                    field.disabled = !showRecipients;
                                });
                            }
                        };

                        if (direction) {
                            direction.addEventListener('change', updateContactFields);
                            updateContactFields();
                        }
                    });
                });
            </script>
        {% endblock %}

