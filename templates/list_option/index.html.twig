{% extends 'base.html.twig' %}

{% block title %}Paramètres des listes{% endblock %}

{% block body %}
    <nav class="breadcrumbs" aria-label="Fil d'Ariane">
        <a href="{{ path('app_dashboard') }}">Tableau de bord</a>
        <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        <span aria-current="page">Listes</span>
    </nav>

    <div class="topbar page-band">
        <div>
            <h1>Paramètres des listes</h1>
            <p>Libellés et valeurs utilisées dans les formulaires de courrier.</p>
        </div>
    </div>

    <section class="form-panel" style="margin-bottom: 18px;">
        <h2>Ajouter une valeur</h2>
        <form method="post" action="{{ path('app_list_option_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('new-list-option') }}">
            <div class="form-grid">
                <div>
                    <label for="category">Liste</label>
                    <select id="category" name="category" required>
                        {% for category, label in categories %}
                            {% if category in open_categories %}
                                <option value="{{ category }}">{{ label }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="label">Libellé</label>
                    <input id="label" name="label" required>
                </div>
                <div>
                    <label for="value">Valeur technique</label>
                    <input id="value" name="value" placeholder="Automatique si vide">
                </div>
                <div>
                    <label for="position">Ordre</label>
                    <input id="position" name="position" type="number" value="0">
                </div>
                <div style="align-self: end;">
                    <button type="submit">Ajouter</button>
                </div>
            </div>
        </form>
    </section>

    <div class="grid">
        {% for category, label in categories %}
            <section class="form-panel">
                <div class="topbar" style="margin-bottom: 12px;">
                    <div>
                        <h2>{{ label }}</h2>
                        {% if category not in open_categories %}
                            <p>Valeurs techniques protégées. Vous pouvez modifier le libellé, l'ordre et l'activation.</p>
                        {% endif %}
                    </div>
                </div>

                <div class="table-wrap" data-loading-skeleton>
                    <table>
                        <thead>
                            <tr>
                                <th>Libellé</th>
                                <th>Valeur</th>
                                <th>Ordre</th>
                                <th>Actif</th>
                                <th class="table-actions-heading">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for option in groupedOptions[category] %}
                                <tr>
                                    <td colspan="5">
                                        <form method="post" action="{{ path('app_list_option_edit', {id: option.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('edit-list-option' ~ option.id) }}">
                                            <div class="filters">
                                                <div>
                                                    <label for="label-{{ option.id }}">Libellé</label>
                                                    <input id="label-{{ option.id }}" name="label" value="{{ option.label }}" required>
                                                </div>
                                                <div>
                                                    <label for="value-{{ option.id }}">Valeur</label>
                                                    <input id="value-{{ option.id }}" name="value" value="{{ option.value }}" {{ option.locked ? 'readonly' : '' }}>
                                                </div>
                                                <div>
                                                    <label for="position-{{ option.id }}">Ordre</label>
                                                    <input id="position-{{ option.id }}" name="position" type="number" value="{{ option.position }}">
                                                </div>
                                                <div>
                                                    <label for="active-{{ option.id }}">Actif</label>
                                                    <input id="active-{{ option.id }}" name="active" type="checkbox" value="1" {{ option.active ? 'checked' : '' }}>
                                                </div>
                                                <div class="actions" style="align-self: end;">
                                                    <button class="secondary" type="submit">Mettre à jour</button>
                                                    {% if not option.locked %}
                                                        <button class="danger" type="submit" form="delete-option-{{ option.id }}">Supprimer</button>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </form>
                                        {% if not option.locked %}
                                            <form id="delete-option-{{ option.id }}" method="post" action="{{ path('app_list_option_delete', {id: option.id}) }}" onsubmit="return confirm('Supprimer cette valeur ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-list-option' ~ option.id) }}">
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr class="table-empty-row">
                                    <td colspan="5">
                                        <div class="empty-state empty-state--table">
                                            <span class="empty-state__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                                                    <path d="M19.4 15a1.8 1.8 0 0 0 .36 1.98l.05.05a2.1 2.1 0 0 1-2.97 2.97l-.05-.05a1.8 1.8 0 0 0-1.98-.36 1.8 1.8 0 0 0-1.09 1.65V21a2.1 2.1 0 0 1-4.2 0v-.07a1.8 1.8 0 0 0-1.09-1.65 1.8 1.8 0 0 0-1.98.36l-.05.05a2.1 2.1 0 0 1-2.97-2.97l.05-.05A1.8 1.8 0 0 0 4.6 15a1.8 1.8 0 0 0-1.65-1.09H2.9a2.1 2.1 0 0 1 0-4.2h.07A1.8 1.8 0 0 0 4.6 8a1.8 1.8 0 0 0-.36-1.98l-.05-.05A2.1 2.1 0 0 1 7.16 3l.05.05A1.8 1.8 0 0 0 9.2 3.4 1.8 1.8 0 0 0 10.29 1.75V1.7a2.1 2.1 0 0 1 4.2 0v.07A1.8 1.8 0 0 0 15.58 3.4a1.8 1.8 0 0 0 1.98-.36l.05-.05a2.1 2.1 0 0 1 2.97 2.97l-.05.05A1.8 1.8 0 0 0 19.4 8a1.8 1.8 0 0 0 1.65 1.09h.05a2.1 2.1 0 0 1 0 4.2h-.07A1.8 1.8 0 0 0 19.4 15z"/>
                                                </svg>
                                            </span>
                                            <h2>Aucune valeur paramétrée</h2>
                                            <p>Ajoutez une première valeur pour alimenter cette liste dans les formulaires.</p>
                                            {% if category in open_categories %}
                                                <div class="actions">
                                                    <a class="button" href="#label">Ajouter une valeur</a>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
