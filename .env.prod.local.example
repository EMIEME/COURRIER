APP_SECRET=replace-with-output-of-php-random-bytes
SERVER_NAME=ddadoc.org
DEFAULT_URI=https://ddadoc.org
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port,x-forwarded-prefix
SYMFONY_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

MARIADB_VERSION=11.4
MARIADB_DATABASE=gestion_courrier
MARIADB_USER=app
MARIADB_PASSWORD=replace-with-production-database-password
MARIADB_ROOT_PASSWORD=replace-with-production-root-password

# Exemple IONOS. Encodez les caracteres speciaux du login/mot de passe dans l'URL
# (ex: @ devient %40).
MAILER_DSN=smtps://utilisateur%40domaine.tld:mot-de-passe@smtp.ionos.fr:465
APP_MAIL_FROM_ADDRESS=utilisateur@domaine.tld
APP_MAIL_FROM_NAME="Gestion Courrier"
APP_MAIL_REPLY_TO_ADDRESS=utilisateur@domaine.tld
